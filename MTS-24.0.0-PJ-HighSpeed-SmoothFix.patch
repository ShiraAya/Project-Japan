+//Now adjust our movement to sync with the server.
+            if (world.isClient()) {
+                /*
+                 * PJ HIGH-SPEED MULTIPLAYER SMOOTH SYNC
+                 *
+                 * MTS normally uses a quadratic correction based on the difference
+                 * between server and client cumulative movement.  At high vehicle
+                 * speeds, normal packet arrival jitter can temporarily create a large
+                 * apparent delta, making that quadratic correction visible as a
+                 * backwards tug.
+                 *
+                 * Keep the existing server-authoritative cumulative-delta protocol,
+                 * but treat a short speed-dependent window as network jitter.  Only
+                 * the error outside that window is corrected, using a capped linear
+                 * response.  Large, sustained divergence still recovers quickly.
+                 */
+                IWrapperPlayer clientPlayer = InterfaceManager.clientInterface.getClientPlayer();
+                boolean localController = clientPlayer != null && clientPlayer.equals(getController());
+
+                //Position sync.
+                clientDeltaM.add(motionApplied);
+                clientDeltaMApplied.set(serverDeltaM).subtract(clientDeltaM);
+                double positionError = clientDeltaMApplied.length();
+                if (positionError > 0D) {
+                    double motionPerTick = motionApplied.length();
+                    double positionDeadzone;
+                    double positionResponse;
+                    double maxPositionCorrection;
+
+                    if (localController) {
+                        positionDeadzone = Math.max(0.15D, motionPerTick * 2.75D);
+                        positionDeadzone = Math.min(positionDeadzone, 6.0D);
+                        positionResponse = 0.08D;
+                        maxPositionCorrection = Math.max(0.10D, motionPerTick * 0.25D);
+                        maxPositionCorrection = Math.min(maxPositionCorrection, 0.50D);
+
+                        //Recover faster if this is real desync rather than packet jitter.
+                        if (positionError > Math.max(12.0D, positionDeadzone * 3.0D)) {
+                            positionResponse = 0.25D;
+                            maxPositionCorrection = 1.50D;
+                        }
+                    } else {
+                        positionDeadzone = Math.max(0.05D, motionPerTick * 1.50D);
+                        positionDeadzone = Math.min(positionDeadzone, 3.0D);
+                        positionResponse = 0.14D;
+                        maxPositionCorrection = Math.max(0.15D, motionPerTick * 0.40D);
+                        maxPositionCorrection = Math.min(maxPositionCorrection, 0.80D);
+
+                        if (positionError > Math.max(8.0D, positionDeadzone * 3.0D)) {
+                            positionResponse = 0.30D;
+                            maxPositionCorrection = 2.00D;
+                        }
+                    }
+
+                    if (positionError <= positionDeadzone) {
+                        //Likely packet jitter.  Do not alter the cumulative client delta.
+                        clientDeltaMApplied.set(0D, 0D, 0D);
+                    } else {
+                        double excessError = positionError - positionDeadzone;
+                        double correctionMagnitude = Math.min(excessError * positionResponse, maxPositionCorrection);
+                        clientDeltaMApplied.scale(correctionMagnitude / positionError);
+                        clientDeltaM.add(clientDeltaMApplied);
+                        position.add(clientDeltaMApplied);
+                    }
+                }
+
+                //Note that orientation wasn't a direct angle-addition, as the rotation is applied relative to the current
+                //orientation.  This means that if we yaw 5 degrees, but are rolling 10 degrees, then we need to not do the
+                //yaw rotation in the XZ plane, but instead in that relative-rotated plane.
+                //To account for this, we get the angle delta between the prior and current orientation, and use that for the delta.
+                if (!rotationApplied.angles.isZero()) {
+                    rotationApplied.angles.set(orientation.angles).subtract(prevOrientation.angles).clamp180();
+                    clientDeltaR.add(rotationApplied.angles);
+                }
+
+                //Rotation sync.
+                clientDeltaRApplied.set(serverDeltaR).subtract(clientDeltaR);
+                double rotationError = clientDeltaRApplied.length();
+                if (rotationError > 0D) {
+                    double rotationPerTick = rotationApplied.angles.length();
+                    double rotationDeadzone;
+                    double rotationResponse;
+                    double maxRotationCorrection;
+
+                    if (localController) {
+                        rotationDeadzone = Math.max(0.35D, rotationPerTick * 2.50D);
+                        rotationDeadzone = Math.min(rotationDeadzone, 8.0D);
+                        rotationResponse = 0.10D;
+                        maxRotationCorrection = 1.25D;
+
+                        if (rotationError > 30.0D) {
+                            rotationResponse = 0.25D;
+                            maxRotationCorrection = 5.0D;
+                        }
+                    } else {
