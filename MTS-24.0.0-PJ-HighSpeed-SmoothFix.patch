+                        maxRotationCorrection = 2.50D;
+
+                        if (rotationError > 20.0D) {
+                            rotationResponse = 0.30D;
+                            maxRotationCorrection = 6.0D;
+                        }
+                    }
+
+                    if (rotationError <= rotationDeadzone) {
